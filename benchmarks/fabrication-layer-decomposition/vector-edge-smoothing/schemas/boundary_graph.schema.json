{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "width", "height", "connectivity", "alphaAudit", "unitBoundarySegmentCount", "vertices", "edges", "regions", "voids"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0-poc"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "connectivity": {"type": "object"},
    "alphaAudit": {"type": "object"},
    "unitBoundarySegmentCount": {"type": "integer", "minimum": 0},
    "vertices": {"type": "array"},
    "edges": {"type": "array"},
    "regions": {"type": "array"},
    "voids": {"type": "array"}
  }
}
