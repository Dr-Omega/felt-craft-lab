{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "freezeTimestamp", "scope", "primaryRoute", "defaultTolerance", "fallbackLadder", "routeDisposition", "geometryContract", "safetyContract", "externalDecision", "evidence", "productionIntegration", "nonGoals", "futureRevalidationTriggers"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "status": {"const": "TOLERANCE_FREEZE_APPROVED"},
    "freezeTimestamp": {"type": "string", "format": "date-time"},
    "scope": {"const": "P0-04C_VECTOR_EDGE_SMOOTHING_FREEZE_BASELINE"},
    "primaryRoute": {"const": "V2_SMOOTH_BEZIER"},
    "defaultTolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "coordinateSystem", "display", "resolutionNormalization"],
      "properties": {
        "value": {"const": 0.5},
        "unit": {"const": "source_pixel"},
        "coordinateSystem": {"const": "structural_label_map"},
        "display": {"const": "0.5 source pixel"},
        "resolutionNormalization": {"const": "NOT_DEFINED_REQUIRES_REVALIDATION"}
      }
    },
    "fallbackLadder": {"const": ["V2_SMOOTH_BEZIER", "V1_SIMPLIFIED_POLYGON", "V0_EXACT_PIXEL_BOUNDARY"]},
    "routeDisposition": {"type": "object"},
    "geometryContract": {"type": "object"},
    "safetyContract": {"type": "object"},
    "externalDecision": {"type": "object"},
    "evidence": {"type": "object"},
    "productionIntegration": {"const": false},
    "nonGoals": {"type": "array", "items": {"type": "string"}},
    "futureRevalidationTriggers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
