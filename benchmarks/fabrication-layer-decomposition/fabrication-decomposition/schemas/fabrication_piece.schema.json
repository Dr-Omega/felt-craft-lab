{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fabrication_piece.schema.json",
  "title": "P0-04B2 Fabrication Piece V0",
  "type": "object",
  "additionalProperties": false,
  "required": ["pieceId", "sourceRegionIds", "sourceComponentIds", "observedGeometry", "inferredGeometry", "finalCutGeometry", "representativeColor", "inferenceType", "confidence", "provenance", "fallbackStatus"],
  "properties": {
    "pieceId": {"type": "string", "pattern": "^FP-FLD-00[1-8]-R[0-9]{5}-C[0-9]{3}$"},
    "sourceRegionIds": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "integer", "minimum": 1}},
    "sourceComponentIds": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^R[0-9]{5}-C[0-9]{3}$"}},
    "observedGeometry": {"type": "object"},
    "inferredGeometry": {"type": "null"},
    "finalCutGeometry": {"type": "object"},
    "representativeColor": {"type": "object"},
    "inferenceType": {"const": "OBSERVED_ONLY"},
    "confidence": {"type": "object"},
    "provenance": {"type": "object"},
    "fallbackStatus": {"type": "object"}
  }
}
