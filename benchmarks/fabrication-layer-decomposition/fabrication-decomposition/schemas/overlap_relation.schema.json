{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlap_relation.schema.json",
  "title": "P0-04B2 Partial Overlap Relation",
  "type": "object",
  "additionalProperties": false,
  "required": ["relationId", "pieceA", "pieceB", "relation", "confidence", "evidence"],
  "properties": {
    "relationId": {"type": "string"},
    "pieceA": {"type": "string"},
    "pieceB": {"type": "string"},
    "relation": {"enum": ["BELOW", "ABOVE", "AMBIGUOUS", "NO_RELATION"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
