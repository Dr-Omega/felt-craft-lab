{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fabrication Layer Decomposition Structural Ground Truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtureId", "expectedColorRegions", "expectedPieces", "expectedStacking", "voidPolicy", "manufacturingNotes", "knownDifficulty", "manualJudgementNotes"],
  "properties": {
    "fixtureId": {"type": "string", "pattern": "^FLD-[0-9]{3}$"},
    "expectedColorRegions": {"type": "object", "additionalProperties": false, "required": ["approximateCount", "mustKeepSeparate", "mustMerge"], "properties": {"approximateCount": {"type": "integer", "minimum": 1}, "mustKeepSeparate": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}}, "mustMerge": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}}}},
    "expectedPieces": {"type": "object", "additionalProperties": false, "required": ["minReasonableCount", "maxReasonableCount"], "properties": {"minReasonableCount": {"type": "integer", "minimum": 1}, "maxReasonableCount": {"type": "integer", "minimum": 1}}},
    "expectedStacking": {"type": "object", "additionalProperties": false, "required": ["requiredBelowRelations"], "properties": {"requiredBelowRelations": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}}}},
    "voidPolicy": {"type": "object", "additionalProperties": false, "required": ["globalVoidsExpected", "mustPreserveGlobalVoid"], "properties": {"globalVoidsExpected": {"type": "integer", "minimum": 0}, "mustPreserveGlobalVoid": {"type": "boolean"}}},
    "manufacturingNotes": {"type": "array", "items": {"type": "string"}},
    "knownDifficulty": {"type": "array", "items": {"type": "string"}},
    "manualJudgementNotes": {"type": "string"}
  }
}
