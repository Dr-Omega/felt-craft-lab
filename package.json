{
  "name": "felt-craft-lab",
  "version": "0.1.0",
  "private": true,
  "description": "不织布儿童美育创作工具",
  "author": "felt-craft-lab",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run && npm run test:assets-builder",
    "test:assets-builder": "python -m unittest discover -s tests/assets -p \"test_build_ywn_manifest.py\" -v",
    "test:watch": "vitest",
    "test:electron-resource": "npm run build -- --mode test && node scripts/run-electron-resource-smoke.cjs",
    "test:electron-ai": "npm run build && node scripts/run-electron-ai-smoke.cjs",
    "test:product-closure": "node scripts/run-product-closure.cjs",
    "test:new-work-all-themes": "node scripts/run-v46-new-work-all-themes.cjs",
    "build:assets": "python scripts/build-ywn-manifest.py",
    "dist:win": "npm run build && electron-builder --win --x64 --config.electronDist=node_modules/electron/dist",
    "dist:win:dir": "npm run build && electron-builder --win --x64 --dir --config.electronDist=node_modules/electron/dist",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "fabric": "5.3.0",
    "howler": "^2.2.4",
    "lottie-web": "^5.12.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/fabric": "5.3.10",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.1.5"
  },
  "build": {
    "appId": "com.feltcraft.lab",
    "productName": "Felt Craft Lab",
    "directories": {
      "output": "release",
      "buildResources": "assets/runtime"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/runtime",
        "to": "assets/runtime",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      },
      {
        "from": "assets/generated",
        "to": "assets/generated",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
