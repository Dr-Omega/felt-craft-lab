# Copy to `.env` for local Electron / electron-vite development.
# Never commit real secrets. Provider API keys live only on the AI Gateway (.env there).

# Build-time public Gateway URL baked into Main (packaged builds should use HTTPS)
FELT_AI_GATEWAY_BASE_URL=http://127.0.0.1:8788

# Runtime override (optional). Packaged remote hosts must be HTTPS.
# AI_GATEWAY_BASE_URL=https://your-ai-gateway.example.com

# Feature flags for local debugging only
FELT_ENABLE_DEVTOOLS=true
