# Copy to `.env` for local Electron / electron-vite development.
# Never commit real secrets. Provider API keys live only on the AI Gateway (.env there).

# Build-time public Gateway URL baked into Main (packaged builds should use HTTPS)
FELT_AI_GATEWAY_BASE_URL=http://127.0.0.1:8788

# Runtime override (optional). Packaged remote hosts must be HTTPS.
# AI_GATEWAY_BASE_URL=https://your-ai-gateway.example.com

# Feature flags for local debugging only
FELT_ENABLE_DEVTOOLS=true

# Public LOCAL development paths, read by `npm run dev` from .env / .env.local.
# Install the existing Python dependencies and model cache separately; no auto-download.
# Quote paths containing spaces. Use the executable path appropriate for your OS.
# FELT_FABRICATION_PYTHON="/path/to/algorithm-env/bin/python"
# FELT_BACKGROUND_PYTHON="/path/to/background-env/bin/python"
# FELT_BIREFNET_CACHE="/path/to/existing/rembg-cache"
# Packaged apps require an external runtime configured in the launch environment:
# FELT_FABRICATION_ROOT="/path/to/fabrication-runtime"
# Shell variables take priority, including explicit empty values (disable override).
# Only development launches inherit these file settings; machine paths are never
# baked into builds or exposed to the renderer. Keep provider keys in backend/.env.

# Acceptance-only: seed unlocked access for all assets in the opened Editor snapshot.
# VITE_ACCEPTANCE_UNLOCK_ALL_ASSETS=true

# Acceptance-only: allow the Library "全部" filter to create a valid Scene and open Editor.
# VITE_ACCEPTANCE_ALL_THEMES_IN_EDITOR=true
