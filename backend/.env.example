# 复制本文件为 .env 后再填写（不要把填好的 .env 上传到 GitHub）

PORT=8788
APP_ENV=development

# Qwen / 阿里云百炼 API Key（两个名字填同一个密钥即可）
QWEN_ASR_API_KEY=
DASHSCOPE_API_KEY=
# 可选：qwen_cloud_http | mock | qwen_cloud_realtime | qwen_local
QWEN_ASR_PROVIDER=qwen_cloud_http

# DeepSeek（后续步骤）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiniMax（后续步骤）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
