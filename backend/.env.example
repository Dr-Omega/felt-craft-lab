# 复制本文件为 .env 后再填写（不要把填好的 .env 上传到 GitHub）
#
# 第 1 步：可以先留空，只保证后端能启动
# 后面接 ASR / DeepSeek / MiniMax 时再填

PORT=8788
APP_ENV=development

# Qwen ASR
QWEN_ASR_API_KEY=
QWEN_ASR_PROVIDER=qwen_cloud_http

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
