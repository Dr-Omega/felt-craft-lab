# 复制本文件为 .env 后再填写（不要把填好的 .env 上传到 GitHub）

PORT=8788
APP_ENV=development

# Qwen / 阿里云百炼
QWEN_ASR_API_KEY=
DASHSCOPE_API_KEY=
QWEN_ASR_PROVIDER=qwen_cloud_http

# DeepSeek 问答
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QA_PROVIDER=deepseek

# MiniMax TTS
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# 国内默认；若国际版账号可改为 https://api.minimax.io/v1/t2a_v2
MINIMAX_API_BASE=https://api.minimaxi.chat/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-02-hd
MINIMAX_VOICE_ID=female-shaonv
TTS_PROVIDER=minimax
