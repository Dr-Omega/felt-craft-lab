# =============================================================================
# 复制本文件为 .env 后再填写真实密钥
#   copy .env.example .env
# 绝对不要把填好的 .env 提交到 GitHub
# 说明文档：docs/ai-services/错误码与重试降级.md
# =============================================================================

PORT=8788
APP_ENV=development

# ---------- Qwen / 阿里云百炼 ASR ----------
# 二选一填写即可（优先读 QWEN_ASR_API_KEY）
QWEN_ASR_API_KEY=
DASHSCOPE_API_KEY=
# 可选：qwen_cloud_http | mock
# realtime / local 为预留通道，当前会返回 PROVIDER_NOT_READY
QWEN_ASR_PROVIDER=qwen_cloud_http

# ---------- DeepSeek 儿童问答 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：deepseek | mock
QA_PROVIDER=deepseek

# ---------- MiniMax TTS（动态 + 固定批量） ----------
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# 国内默认；国际账号可改为 https://api.minimax.io/v1/t2a_v2
MINIMAX_API_BASE=https://api.minimaxi.chat/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-02-hd
MINIMAX_VOICE_ID=female-shaonv
# 可选：minimax | mock
TTS_PROVIDER=minimax

# ---------- 无密钥联调示例（需要时取消注释并改上面的 PROVIDER） ----------
# QWEN_ASR_PROVIDER=mock
# QA_PROVIDER=mock
# TTS_PROVIDER=mock
