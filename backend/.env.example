# =============================================================================
# 复制本文件为 .env 后再填写真实密钥
#   copy .env.example .env
# 绝对不要把填好的 .env 提交到 GitHub
# =============================================================================

PORT=8788
# 必须显式设置；缺失/未知值按非开发 fail-closed（无 mock、无 ephemeral HMAC、无 Flask debug）
APP_ENV=development

# ---------- 分享广场账号 JWT（生产必填） ----------
PLAZA_JWT_SECRET=

# ---------- Qwen / 阿里云百炼 ASR ----------
QWEN_ASR_API_KEY=
DASHSCOPE_API_KEY=
# 生产允许：qwen_cloud_http | qwen_cloud_realtime | qwen_local
# 开发额外允许：mock（未知 provider 一律拒绝，不回退付费）
QWEN_ASR_PROVIDER=qwen_cloud_http

# ---------- DeepSeek 儿童问答 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 生产：deepseek；开发额外：mock
QA_PROVIDER=deepseek

# ---------- MiniMax TTS ----------
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_API_BASE=https://api.minimaxi.chat/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-02-hd
MINIMAX_VOICE_ID=female-shaonv
# 生产：minimax；开发额外：mock
TTS_PROVIDER=minimax

# ---------- 守卫 / 限流（可选） ----------
AI_MAX_AUDIO_BYTES=5242880
UPLOAD_MAX_IMAGE_BYTES=10485760
# Flask 总请求体硬上限（含 multipart 解析开销）
AI_MAX_CONTENT_LENGTH=11010048
AI_MAX_QA_CHARS=500
AI_MAX_TTS_CHARS=500
AI_RATE_WINDOW_SEC=60
AI_RATE_MAX=30
AI_MAX_INFLIGHT=4
# 真实云端 smoke-test（POST）仅开发态且显式开启
AI_SMOKE_ENABLED=false
# ASR 指标目录（默认可写临时目录；勿写安装包只读路径）
# AI_METRICS_DIR=
# AI_METRICS_MAX_BYTES=2097152
# AI_METRICS_KEEP_LINES=2000

# ---------- Session Token（防滥用；非正式账号） ----------
# Gateway 专用 HMAC 密钥：仅留服务端，绝不写入 Electron / 安装包
# 正式环境（APP_ENV 非 development/dev/test）必须配置且足够长；禁止 change-me 占位
AI_SESSION_HMAC_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# APP_ENV 缺失或未知值按非开发（fail-closed）处理；开发请在文件顶部显式写 development
# AI_SESSION_TTL_SEC=3600
# 单安装实例宽松限流（拦异常刷量）
# AI_INSTALL_RATE_WINDOW_SEC=60
# AI_INSTALL_RATE_MAX=120
# AI_INSTALL_DAY_MAX=3000
# Gateway 全局调用保险丝（近似费用保护）
# AI_GLOBAL_MAX_CALLS_PER_HOUR=5000
# AI_GLOBAL_MAX_CALLS_PER_DAY=20000
# AI_TOKEN_ISSUE_WINDOW_SEC=60
# AI_TOKEN_ISSUE_MAX=30
# TTS 缓存有界
# AI_MAX_TTS_AUDIO_BYTES=2097152
# AI_TTS_CACHE_MAX_FILES=200
# AI_TTS_CACHE_MAX_BYTES=104857600
# AI_TTS_CACHE_TTL_SEC=604800

# Electron Main（正式安装包）指向远端 Gateway：
# 构建期（推荐写入安装包）：FELT_AI_GATEWAY_BASE_URL=https://your-ai-gateway.example.com
# 运行时覆盖：AI_GATEWAY_BASE_URL=https://your-ai-gateway.example.com
# 正式远端必须 HTTPS；开发 loopback 可用 http://127.0.0.1:8788

# ---------- 无密钥联调（开发） ----------
# QWEN_ASR_PROVIDER=mock
# QA_PROVIDER=mock
# TTS_PROVIDER=mock
