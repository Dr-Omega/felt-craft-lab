{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "composite": true
  },
  "include": [
    "tests/**/*.ts",
    "src/renderer/src/editor/**/*",
    "src/renderer/src/services/**/*",
    "src/renderer/src/persistence/**/*",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/*.d.ts",
    "server/**/*"
  ]
}
