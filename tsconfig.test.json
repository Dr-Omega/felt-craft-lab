{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "composite": true
  },
  "include": [
    "electron.vite.config.ts",
    "tests/**/*.ts",
    "src/renderer/src/projection/**/*",
    "src/renderer/src/story-card/**/*",
    "src/renderer/src/learning-zone/**/*",
    "src/renderer/src/components/editor/asset-qa.controller.ts",
    "src/renderer/src/workflows/**/*",
    "src/renderer/src/ui/**/*",
    "src/renderer/src/editor/**/*",
    "src/renderer/src/fabrication/**/*",
    "src/renderer/src/services/**/*",
    "src/renderer/src/persistence/**/*",
    "src/renderer/src/catalog/**/*",
    "src/renderer/src/util/**/*",
    "src/renderer/src/app-nav.ts",
    "src/renderer/src/env.d.ts",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/*.d.ts",
    "server/**/*"
  ]
}
